{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tamil-punarchi:rules:1.0",
  "title": "Tamil Punarchi Rule Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "language", "description", "sources", "rule_count", "rules"],
  "properties": {
    "schema_version": {"type": "string"},
    "catalog_version": {"type": "string"},
    "language": {"const": "ta"},
    "description": {"type": "string"},
    "sources": {"type": "object", "additionalProperties": {"type": "string", "format": "uri"}},
    "rule_count": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "name_ta", "name_en", "decision", "preconditions", "requires_annotations", "examples_correct", "examples_incorrect", "acceptable_alternatives", "layer", "tier", "source_ids", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "category": {"type": "string", "minLength": 1},
          "name_ta": {"type": "string", "minLength": 1},
          "name_en": {"type": "string", "minLength": 1},
          "decision": {"enum": ["CLASSIFY", "INSERT_HARD", "NO_INSERT", "ALLOW_VARIANTS", "TRANSFORM_COMPOUND", "LEXICON_REVIEW", "REVIEW", "PROTECT"]},
          "preconditions": {"type": "string", "minLength": 1},
          "requires_annotations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "examples_correct": {"type": "array", "items": {"type": "string"}},
          "examples_incorrect": {"type": "array", "items": {"type": "string"}},
          "acceptable_alternatives": {"type": "array", "items": {"type": "string"}},
          "layer": {"enum": ["classical", "modern", "classical_and_modern", "house", "engineering"]},
          "tier": {"enum": ["block", "candidate", "review"]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
